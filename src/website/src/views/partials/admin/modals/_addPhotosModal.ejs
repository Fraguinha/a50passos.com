<div class="text-center">
    <button type="button"
            class="btn btn-success"
            data-toggle="modal"
            data-target="#addPhotosModal">
        <strong>+</strong> <i class="bi bi-camera-fill"></i>
    </button>
</div>
<div class="modal fade"
     id="addPhotosModal"
     tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="exampleModalLabel">
                    Adicionar Fotos
                </h5>
                <button type="button"
                        class="close"
                        data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="form-control-file"
                      action="/api/admin/addPhotos"
                      method="POST"
                      enctype="multipart/form-data">
                    <% for (let i = 0; i < Math.ceil(num_photos / 4); i++) { %>
                        <div class="row">
                            <% for (let j = 1; j <= 4; j++) { %>
                                <% if (i * 4 + j <= num_photos) { %>
                                    <br>
                                    <div class="col-md-3 mt-4">
                                        <div class="background-white">
                                            <img src="/api/images/temporary/<%= i * 4 + j %>"
                                                 alt="photo<%= i * 4 + j %>"
                                                 height="200"
                                                 width="100%">
                                        </div>
                                    </div>
                                <% } %>
                            <% } %>
                        </div>
                    <% } %>
                    <hr>
                    <input type="file"
                           name="photos"
                           multiple
                           required>
                    <hr>
                    <div class="text-center">
                        <button class="btn btn-primary btn-block"
                                type="submit">
                            Upload fotos
                        </button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">
                    Fechar
                </button>
                <form action="/api/admin/clearPhotos"
                      method="POST">
                    <button class="btn btn-warning"
                            type="submit">
                        Limpar Fotos
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
