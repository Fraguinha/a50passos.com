<form action="/api/admin/addHouse"
      method="POST">
    <div class="text-center">
        <button type="button"
                class="btn btn-success mx-1"
                data-toggle="modal"
                data-target="#createHouseModal">
            <strong>+</strong> <i class="bi bi-house-fill"></i>
        </button>
    </div>
    <div class="modal fade"
         id="createHouseModal"
         tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"
                        id="exampleModalLabel">
                        Adicionar Casa
                    </h5>
                    <button type="button"
                            class="close"
                            data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <%- include("_houseInformation.ejs") %>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-dismiss="modal">
                        Fechar
                    </button>
                    <button type="submit"
                            class="btn btn-success">
                        Publicar
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
